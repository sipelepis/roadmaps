# cp .env.example apps/api/.env and fill in the two keys.
DATABASE_URL=postgresql://rag:rag@localhost:5433/rag

# Answer generation (claude-opus-5).
ANTHROPIC_API_KEY=sk-ant-...

# Embeddings: OpenAI text-embedding-3-small, 1536 dims. Any OpenAI-compatible
