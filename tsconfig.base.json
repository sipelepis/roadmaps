{
  "compileOnSave": false,
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@rag/shared": ["libs/shared/src/index.ts"],
      "@boost/ui": ["libs/ui/src/index.ts"],
      "@boost/styles/*": ["libs/styles/src/*"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
