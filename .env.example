# cp .env.example apps/api/.env and fill in the two keys.
DATABASE_URL=postgresql://rag:rag@localhost:5433/rag

# Answer generation (claude-opus-5).
ANTHROPIC_API_KEY=sk-ant-...

# Embeddings. Any OpenAI-compatible endpoint; OpenRouter is the default and
# serves text-embedding-3-small at its native 1536 dims. To go direct to OpenAI:
#   EMBEDDING_BASE_URL=https://api.openai.com/v1
#   EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=sk-or-v1-...
